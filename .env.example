# Copy to .env and fill required values. Never commit the completed .env.
# This example is for local development. Production settings are in docs/deployment.md.

# REQUIRED for local Compose. Generate a value with: openssl rand -hex 24
# Use random hexadecimal here so the same password is safe inside a database URL.
POSTGRES_PASSWORD=

# Native Go connects through the loopback-bound Compose port.
# Compose overrides this with the postgres service hostname inside its network.
DATABASE_URL="postgres://publisher:${POSTGRES_PASSWORD}@127.0.0.1:5432/publisher?sslmode=disable"
PUBLIC_BASE_URL=http://localhost:8080
DEV_MODE=true
PORT=8080

# REQUIRED. Run publisher keygen and paste its values below.
JWT_HMAC_KEY=
JWT_ISSUER=social-publisher-local
JWT_AUDIENCE=social-publisher-api
# Keep the outer single quotes in this dotenv file; the inner value is JSON.
TOKEN_ENCRYPTION_KEYS='{"primary":"REPLACE_WITH_KEYGEN_ENCRYPTION_KEY"}'
ACTIVE_TOKEN_KEY_ID=primary
# Optional locally; required in production. Use the separate keygen value.
OPERATIONS_TOKEN=

# Exact DNS hostnames, separated by commas. Replace with origins you control.
# Empty blocks all media URLs; text-only X posts can still be used.
MEDIA_ALLOWED_HOSTS=
MAX_MEDIA_BYTES=1073741824
WORKER_CONCURRENCY=6
DB_MAX_CONNS=32
JOB_TIMEOUT_SECONDS=600

# Shared PostgreSQL admission limits; tune only after measuring your workload.
API_REQUESTS_PER_MINUTE=60
API_OWNER_CONCURRENCY=4
API_ACCOUNT_CONCURRENCY=1
PENDING_TARGETS_PER_OWNER=1000
EVENT_RETENTION_DAYS=90
RETENTION_BATCH_SIZE=500

# Optional platforms: leave BOTH credentials empty to disable a platform.
# Redirect URIs are PUBLIC_BASE_URL + /oauth/{platform}/callback.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Set true only after TikTok has actually approved the relevant API audit.
TIKTOK_AUDITED=false
X_CLIENT_ID=
X_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_GRAPH_VERSION=v26.0
